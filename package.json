{
  "name": "gatsby-starter-paradigmshift",
  "version": "0.0.1",
  "description": "Gatsby.js V2 starter template based on Paradigm Shift by HTML5 UP",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anubhavsrivastava/gatsby-starter-paradigmshift.git"
  },
  "author": {
    "name": "Anubhav Srivastava",
    "email": "anubhav.srivastava00@gmail.com"
  },
  "dependencies": {
    "gatsby": "^5.16.1",
    "gatsby-plugin-manifest": "^5.16.0",
    "gatsby-plugin-netlify": "^5.1.1",
    "gatsby-plugin-offline": "^6.16.0",
    "gatsby-plugin-react-helmet": "^6.16.0",
    "gatsby-plugin-recaptcha": "^1.0.5",
    "gatsby-plugin-sass": "^6.16.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-helmet": "^6.1.0",
    "react-scrollspy": "^3.4.0",
    "sass": "^1.80.0",
    "smoothscroll-polyfill": "^0.4.4",
    "yet-another-react-lightbox": "^3.25.0"
  },
  "scripts": {
    "develop": "gatsby develop",
    "build": "npm run clean && gatsby build",
    "deploy": "npm run clean && gatsby build --prefix-paths && gh-pages -d public",
    "serve": "gatsby serve",
    "clean": "node -e \"const fs = require('fs'); for (const path of ['.cache', 'public']) fs.rmSync(path, { recursive: true, force: true })\"",
    "format": "prettier --write '**/*.js'",
    "test": "node --test"
  },
  "devDependencies": {
    "gh-pages": "^6.3.0",
    "prettier": "^1.17.0"
  },
  "keywords": [
    "gatsby",
    "gatsby-starter",
    "gatsby-starter-paradigmshift"
  ],
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/anubhavsrivastava/gatsby-starter-paradigmshift/issues"
  },
  "homepage": "https://github.com/anubhavsrivastava/gatsby-starter-paradigmshift#readme",
  "overrides": {
    "@ardatan/relay-compiler": {
      "immutable": "~3.8.4"
    },
    "cookie": "^0.7.2",
    "gatsby": {
      "path-to-regexp": "0.1.13",
      "uuid": "^11.1.1"
    },
    "lodash": "^4.18.1",
    "resolve-url-loader": "^5.0.0",
    "serialize-javascript": "^7.1.4",
    "sharp": "0.35.5",
    "tmp": "^0.2.7",
    "webpack": "^5.112.2"
  }
}
